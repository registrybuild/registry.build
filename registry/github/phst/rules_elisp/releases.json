ernary conditionals using ‘case’ function by @phst in https://github.com/phst/rules_elisp/pull/1999\n\n\n**Full Changelog**: https://github.com/phst/rules_elisp/compare/v0.0.2...v0.0.3","mentions_count":1},{"url":"https://api.github.com/repos/phst/rules_elisp/releases/365493292","assets_url":"https://api.github.com/repos/phst/rules_elisp/releases/365493292/assets","upload_url":"https://uploads.github.com/repos/phst/rules_elisp/releases/365493292/assets{?name,label}","html_url":"https://github.com/phst/rules_elisp/releases/tag/v0.0.2","id":365493292,"author":{"login":"phst","id":398701,"node_id":"MDQ6VXNlcjM5ODcwMQ==","avatar_url":"https://avatars.githubusercontent.com/u/398701?v=4","gravatar_id":"","url":"https://api.github.com/users/phst","html_url":"https://github.com/phst","followers_url":"https://api.github.com/users/phst/followers","following_url":"https://api.github.com/users/phst/following{/other_user}","gists_url":"https://api.github.com/users/phst/gists{/gist_id}","starred_url":"https://api.github.com/users/phst/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/phst/subscriptions","organizations_url":"https://api.github.com/users/phst/orgs","repos_url":"https://api.github.com/users/phst/repos","events_url":"https://api.github.com/users/phst/events{/privacy}","received_events_url":"https://api.github.com/users/phst/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDODxkRX84VyPws","tag_name":"v0.0.2","target_commitish":"master","name":"v0.0.2","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-08-05T11:46:30Z","updated_at":"2026-08-05T11:58:03Z","published_at":"2026-08-05T11:58:03Z","assets":[{"url":"https://api.github.com/repos/phst/rules_elisp/releases/assets/502567351","id":502567351,"node_id":"RA_kwDODxkRX84d9JG3","name":"rules_elisp-v0.0.2.tar.gz","label":"","uploader":{"login":"phst","id":398701,"node_id":"MDQ6VXNlcjM5ODcwMQ==","avatar_url":"https://avatars.githubuserc